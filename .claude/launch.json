{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mars-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 1440
    },
    {
      "name": "mars-dev-https",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:https"
      ],
      "port": 1441,
      "url": "https://localhost:1441"
    },
    {
      "name": "mars-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:demo"
      ],
      "port": 1442
    },
    {
      "name": "coffeebrain-warehouse",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "C:/Projects/coffeebrain/CoffeeBrain Warehouse",
        "run",
        "dev"
      ],
      "port": 1460
    }
  ]
}
